  <ItemGroup>
    <ProjectReference Include="..\StudentFeePoc\StudentFeePoc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
