# ==============================================================================
# Central Configuration & Port Management (.env.example)
# Copy this file to .env and fill in your environment-specific credentials:
# cp .env.example .env
# ==============================================================================

# Target PostgreSQL Host Port (Port forwarding: 15432:5432 avoids standard 5432 collisions)
PG_PORT=15432

# ASP.NET Core Web API Host Port
API_PORT=5000

# PostgreSQL Target Settings
PG_HOST=localhost
PG_DB=rpg
PG_USER=postgres
PG_PASSWORD=YourSecurePasswordHere

# RavenDB Source Configuration
RAVEN_URL=https://<your-cluster-name>.ravendb.cloud
RAVEN_DB=rpg
RAVEN_CERT_FILE=certs/<your-client-cert>.pfx
RAVEN_CERT_PASSWORD=

# Migration Tuning & Collection Names
PAGE_SIZE=500
TIMEOUT_SEC=30
PERSONAS_COLLECTION=Personas
COURSES_COLLECTION=Courses
STAFFS_COLLECTION=Staffs
ORG_COLLECTION=Orgs
INSTITUTE_COLLECTION=Institutes
STUDENT_COLLECTION=Students
FEES_COLLECTION=Fees
FEE_TXS_COLLECTION=FeeTxes
EXAMS_COLLECTION=Exams
